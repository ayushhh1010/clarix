# Clarix configuration.
#
# Copy to .env and fill in. Every key here maps to a field on
# app/config.py::Settings; nothing is read that is not declared there.
#
# The v1 version of this file listed Ollama, a MiniLM embedding model,
# Redis and ChromaDB. None of those exist any more.

# ─── Database ─────────────────────────────────────────────────────────────
# PostgreSQL with pgvector >= 0.7.0. The schema needs halfvec and
# binary_quantize, which landed in 0.7.0; migration 0002 checks the version
# and fails with a clear message rather than on a missing type.
#
# `docker compose up -d` provides a suitable server on port 5433.
DATABASE_URL=postgresql+asyncpg://clarix:clarix_secret@localhost:5433/clarix_db

# ─── Query embedding ──────────────────────────────────────────────────────
# The API does not load the embedding model. It calls the indexer process
# (`python -m app.indexing`) so both sides use the same encoder -- vectors
# from different models are not comparable, and mixing them degrades
# retrieval silently rather than loudly.
#
# LEAVING THIS EMPTY IS SUPPORTED BUT LOSSY: the dense arm is skipped and
# only lexical + symbol retrieval run. /health reports which is in effect.
EMBEDDING_ENDPOINT=http://localhost:8081/embed

# Shared secret between the API and the indexer. The indexer REFUSES TO
# START in production without one: the endpoint runs a model on
# caller-supplied text, so an open one is free compute for whoever finds it.
EMBEDDING_API_KEY=generate-a-long-random-string

# Must match the model the index was built with. A mismatch disables dense
# retrieval rather than ranking on incomparable vectors.
EMBEDDING_MODEL_ID=jinaai/jina-embeddings-v2-base-code

# ─── Indexer process ──────────────────────────────────────────────────────
INDEXER_PORT=8081
# Set false to serve /embed without claiming indexing jobs (useful if you
# want to scale query embedding separately from indexing).
INDEXER_RUN_WORKER=true
# Chunks per lock acquisition. The worker and the query endpoint share one
# model, so this sets the worst case a query waits behind indexing.
# 1 is measured-optimal: throughput is flat across batch sizes with the ONNX
# arena off, while lock hold scales linearly (bench/bench_embed_batch.py).
INDEXER_EMBED_BATCH=1

# Bump to force every repository to reindex (e.g. after changing the
# chunker or the tsvector function).
INDEX_VERSION=1
# Chunks accumulated before a database flush. Not the embedding batch.
INDEX_BATCH_SIZE=64
WORKER_DIR=./data/work
REPOS_DIR=./data/repos

# ─── LLM providers ────────────────────────────────────────────────────────
# All optional. Providers with no key are not constructed, so the router's
# candidate list is exactly what is configured here. With none set, the API
# still retrieves and returns citations with degraded=true.
#
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat:free

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ─── Retrieval ────────────────────────────────────────────────────────────
RAG_TOP_K=20
# Hard cap, counted with the real tokenizer. Sits under the tightest
# free-tier context limit with room for the system prompt and the answer.
CONTEXT_BUDGET_TOKENS=4000

# ─── Application ──────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# The default placeholder is rejected when APP_ENV=production.
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ─── OAuth (optional) ─────────────────────────────────────────────────────
# https://github.com/settings/developers
# Callback: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# https://console.cloud.google.com/apis/credentials
# Callback: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
